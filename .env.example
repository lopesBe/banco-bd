# Copie para .env:  cp .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)

# ---- PostgreSQL (container) ----
POSTGRES_USER=smartbase
POSTGRES_PASSWORD=smartbase_dev_123
POSTGRES_DB=smartbase
POSTGRES_PORT=5432

# ---- pgAdmin (container) ----
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_PORT=5050

# ---- Node / Prisma (smart-base) ----
DATABASE_URL=postgresql://smartbase:smartbase_dev_123@localhost:5432/smartbase?schema=public

# ---- Aplicação Java (JDBC) ----
DB_URL=jdbc:postgresql://localhost:5432/smartbase
DB_USER=smartbase
DB_PASSWORD=smartbase_dev_123

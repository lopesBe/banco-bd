// Smart-Base / Helpdesk + Loja de Eletrônicos
// Schema normalizado (3FN). Nomes de tabelas/colunas em snake_case via @@map/@map
// para que a aplicação Java (JDBC) consuma o mesmo banco de forma simples.
//
// Observação: a coluna `embedding vector(384)` (pgvector) é declarada como Unsupported porque o
// Prisma não suporta o tipo nativamente. A coluna e os índices HNSW (vector_cosine_ops) são
// criados pela migration SQL manual `add_pgvector_embeddings`. Os @@index([embedding]) abaixo
// existem apenas para o Prisma reconhecer esses índices (pelo nome) e não gerar "drift".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  CLIENTE
  ADMIN
  ATENDENTE

  @@map("papel_usuario")
}

enum StatusPedido {
  PENDENTE
  PAGO
  ENVIADO
  ENTREGUE
  CANCELADO

  @@map("status_pedido")
}

enum StatusChamado {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO_CLIENTE
  RESOLVIDO
  FECHADO

  @@map("status_chamado")
}

enum PrioridadeChamado {
  BAIXA
  MEDIA
  ALTA
  URGENTE

  @@map("prioridade_chamado")
}

model Usuario {
  id        Int          @id @default(autoincrement())
  nome      String       @db.VarChar(150)
  email     String       @unique @db.VarChar(200)
  cidade    String?      @db.VarChar(100)
  papel     PapelUsuario @default(CLIENTE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  pedidos             Pedido[]
  chamadosSolicitados ChamadoSuporte[] @relation("ChamadoSolicitante")
  chamadosAtendidos   ChamadoSuporte[] @relation("ChamadoAtendente")
  artigos             ArtigoBase[]

  @@index([papel])
  @@map("usuario")
}

model Categoria {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  paiId     Int?     @map("id_pai")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  pai           Categoria?       @relation("Subcategorias", fields: [paiId], references: [id], onDelete: SetNull)
  subcategorias Categoria[]      @relation("Subcategorias")
  produtos      Produto[]
  chamados      ChamadoSuporte[]
  artigos       ArtigoBase[]

  @@index([paiId])
  @@map("categoria")
}

model Fornecedor {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(150)
  cnpj      String   @unique @db.VarChar(20)
  cidade    String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  produtos Produto[]

  @@map("fornecedor")
}

model Produto {
  id           Int      @id @default(autoincrement())
  nome         String   @db.VarChar(200)
  descricao    String?  @db.Text
  preco        Decimal  @db.Decimal(10, 2)
  estoque      Int      @default(0)
  sku          String   @unique @db.VarChar(60)
  categoriaId  Int?     @map("id_categoria")
  fornecedorId Int?     @map("id_fornecedor")
  embedding    Unsupported("vector(384)")?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  categoria  Categoria?       @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  fornecedor Fornecedor?      @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  itens      ItemPedido[]
  custos     CustoProduto[]
  chamados   ChamadoSuporte[]

  @@index([categoriaId])
  @@index([fornecedorId])
  @@index([nome])
  @@index([embedding], map: "produto_embedding_hnsw_idx")
  @@map("produto")
}

model CustoProduto {
  id              Int      @id @default(autoincrement())
  produtoId       Int      @map("id_produto")
  custo           Decimal  @db.Decimal(10, 2)
  dataAtualizacao DateTime @default(now()) @map("data_atualizacao") @db.Date

  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([produtoId])
  @@map("custo_produto")
}

model Pedido {
  id        Int          @id @default(autoincrement())
  usuarioId Int          @map("id_usuario")
  data      DateTime     @default(now()) @db.Date
  total     Decimal      @db.Decimal(12, 2)
  status    StatusPedido @default(PENDENTE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at")

  usuario Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  itens   ItemPedido[]

  @@index([usuarioId])
  @@index([data])
  @@map("pedido")
}

// Tabela associativa N:N entre Pedido e Produto
model ItemPedido {
  id            Int     @id @default(autoincrement())
  pedidoId      Int     @map("id_pedido")
  produtoId     Int     @map("id_produto")
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([pedidoId])
  @@index([produtoId])
  @@map("item_pedido")
}

model ChamadoSuporte {
  id            Int               @id @default(autoincrement())
  titulo        String            @db.VarChar(250)
  descricao     String            @db.Text
  status        StatusChamado     @default(ABERTO)
  prioridade    PrioridadeChamado @default(MEDIA)
  solicitanteId Int               @map("id_solicitante")
  atendenteId   Int?              @map("id_atendente")
  produtoId     Int?              @map("id_produto")
  categoriaId   Int?              @map("id_categoria")
  embedding     Unsupported("vector(384)")?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at")

  solicitante Usuario    @relation("ChamadoSolicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  atendente   Usuario?   @relation("ChamadoAtendente", fields: [atendenteId], references: [id], onDelete: SetNull)
  produto     Produto?   @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  @@index([status, prioridade])
  @@index([solicitanteId])
  @@index([atendenteId])
  @@index([produtoId])
  @@index([categoriaId])
  @@index([embedding], map: "chamado_suporte_embedding_hnsw_idx")
  @@map("chamado_suporte")
}

model ArtigoBase {
  id          Int      @id @default(autoincrement())
  titulo      String   @db.VarChar(250)
  conteudo    String   @db.Text
  autorId     Int?     @map("id_autor")
  categoriaId Int?     @map("id_categoria")
  publicado   Boolean  @default(true)
  embedding   Unsupported("vector(384)")?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  autor     Usuario?   @relation(fields: [autorId], references: [id], onDelete: SetNull)
  categoria Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  @@index([autorId])
  @@index([categoriaId])
  @@index([embedding], map: "artigo_base_embedding_hnsw_idx")
  @@map("artigo_base")
}
